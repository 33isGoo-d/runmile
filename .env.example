POSTGRES_DB=runmile
POSTGRES_USER=runmile
POSTGRES_PASSWORD=runmile_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_KAKAO_MAP_API_KEY=replace-with-kakao-map-javascript-key

# Polygon Amoy 완주 증명 조회 설정
DAEGU_CHAIN_RPC_URL=https://polygon-amoy.drpc.org
DAEGU_CHAIN_NETWORK_NAME=POLYGON_AMOY
DAEGU_CHAIN_ID=80002
# 최소 확인 블록 수와 RPC 요청 제한시간
DAEGU_CHAIN_MINIMUM_CONFIRMATIONS=1
DAEGU_CHAIN_RPC_TIMEOUT_SECONDS=10
DAEGU_CHAIN_VERIFICATION_CACHE_SECONDS=30
DAEGU_CHAIN_VERIFICATION_CACHE_MAX_SIZE=1000
# 일반 Backend가 앵커를 검증할 때 사용하는 공개 주소입니다. 비밀값이 아닙니다.
DAEGU_CHAIN_TRUSTED_ADDRESS=0xe957f0ad734260f9677b4d53e8d42c0c86556367
# 로컬 anchor-demo 명령에서만 쓰는 서명 키입니다. 배포하거나 커밋하지 마세요.
DAEGU_CHAIN_PRIVATE_KEY=
# 특정 참가자만 처리할 때 ID를 입력합니다.
DAEGU_CHAIN_ANCHOR_RUNNER_ID=
# 모든 기록을 처리할 때만 명시적으로 true로 바꿉니다.
DAEGU_CHAIN_ANCHOR_ALL=false
# 체인 성공 후 DB 저장에 실패한 경우 기존 거래 해시로 복구할 때만 입력합니다.
DAEGU_CHAIN_RECOVERY_TX_HASH=
